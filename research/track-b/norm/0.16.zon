// Normalizer rules for the raw dump of Zig 0.16.0 (schema v1 output). See 0.17.zon for the format.
.{
    .param_ty_path = "data.ty.as_type",
    .unsupported = .{
        "legalize_vec_elem_val",
        "legalize_vec_store_elem",
        "legalize_compiler_rt_call",
        "inferred_alloc",
        "inferred_alloc_comptime",
        "shuffle_one",
        "shuffle_two",
        "wasm_memory_size",
        "wasm_memory_grow",
        "work_item_id",
        "work_group_size",
        "work_group_id",
    },
    .rules = .{
        .{ .key = "bin_op", .ops = .{ "data.lhs", "data.rhs" }, .attrs = .{.{ .key = "order", .kind = .str, .from_tag = "atomic_store_" }} },
        .{ .key = "un_op", .ops = .{"data"} },
        .{ .key = "ty_op", .ignore = .{"data.ty"}, .ops = .{"data.operand"} },
        .{ .key = "no_op" },
        .{ .key = "ty", .ignore = .{"data"} },
        .{ .key = "ty_pl", .ignore = .{"data.ty", "data.payload"} },
        .{ .key = "arg", .ignore = .{"data.ty"}, .attrs = .{.{ .key = "index", .kind = .int, .path = "data.zir_param_index" }} },
        .{ .key = "dbg_stmt", .special = .dbg_stmt },
        .{ .key = "br", .ops = .{"data.operand"}, .attrs = .{.{ .key = "target", .kind = .inst, .path = "data.block_inst" }} },
        .{ .key = "repeat", .attrs = .{.{ .key = "target", .kind = .inst, .path = "data.loop_inst" }} },
        .{ .key = "atomic_load", .ops = .{"data.ptr"}, .attrs = .{.{ .key = "order", .kind = .str, .path = "data.order" }} },
        .{ .key = "prefetch", .ignore = .{"data.rw", "data.cache"}, .ops = .{"data.ptr"}, .attrs = .{.{ .key = "locality", .kind = .int, .path = "data.locality" }} },
        .{ .key = "reduce", .ops = .{"data.operand"}, .attrs = .{.{ .key = "operation", .kind = .str, .path = "data.operation" }} },
        .{ .key = "ty_nav", .ignore = .{"data.ty"}, .attrs = .{.{ .key = "nav", .kind = .str, .path = "data.nav" }} },
        .{ .key = "ty_pl/Bin", .ignore = .{"data.ty"}, .ops = .{ "payload.value.lhs", "payload.value.rhs" } },
        .{ .key = "ty_pl/StructField", .ignore = .{"data.ty"}, .ops = .{"payload.value.struct_operand"}, .attrs = .{.{ .key = "field", .kind = .int, .path = "payload.value.field_index" }} },
        .{ .key = "ty_pl/UnionInit", .ignore = .{"data.ty"}, .ops = .{"payload.value.init"}, .attrs = .{.{ .key = "field", .kind = .int, .path = "payload.value.field_index" }} },
        .{ .key = "ty_pl/FieldParentPtr", .ignore = .{"data.ty"}, .ops = .{"payload.value.field_ptr"}, .attrs = .{.{ .key = "field", .kind = .int, .path = "payload.value.field_index" }} },
        .{
            .key = "ty_pl/Cmpxchg", .ignore = .{"data.ty", "payload.value.flags"},
            .ops = .{ "payload.value.ptr", "payload.value.expected_value", "payload.value.new_value" },
            .attrs = .{
                .{ .key = "success", .kind = .str, .path = "payload.value.successOrder" },
                .{ .key = "failure", .kind = .str, .path = "payload.value.failureOrder" },
            },
        },
        .{ .key = "ty_pl/VectorCmp", .ignore = .{"data.ty", "payload.value.flags"}, .ops = .{ "payload.value.lhs", "payload.value.rhs" }, .attrs = .{.{ .key = "op", .kind = .str, .path = "payload.value.compareOperator" }} },
        .{ .key = "ty_pl/elements", .ignore = .{"data.ty"}, .ops = .{"payload"} },
        .{ .key = "ty_pl/Block", .ignore = .{"data.ty", "payload.value.ty"}, .bodies = .{.{ .label = "$tag", .path = "payload.value.body" }} },
        .{
            .key = "ty_pl/DbgInlineBlock", .ignore = .{"data.ty", "payload.value.ty"},
            .special = .inline_block,
            .attrs = .{.{ .key = "callee", .kind = .inline_target, .path = "payload.value.func.fn.fqn" }},
            .bodies = .{.{ .label = "inline", .path = "payload.value.body" }},
        },
        .{ .key = "ty_pl/TryPtr", .ignore = .{"data.ty", "payload.value.error_union_payload_ptr_ty"}, .ops = .{"payload.value.error_union_ptr"}, .bodies = .{.{ .label = "error", .path = "payload.value.else_body" }} },
        .{
            .key = "ty_pl/Asm", .ignore = .{"data.ty", "payload.value.input_constraint_names", "payload.value.output_constraint_names", "payload.value.clobbers"},
            .ops = .{ "payload.value.outputs", "payload.value.inputs" },
            .attrs = .{
                .{ .key = "source", .kind = .str, .path = "payload.value.source" },
                .{ .key = "volatile", .kind = .flag, .path = "payload.value.is_volatile" },
            },
        },
        .{ .key = "pl_op/Call", .ignore = .{"data.operand"}, .ops = .{ "payload.value.callee", "payload.value.args" }, .attrs = .{.{ .key = "callee", .kind = .call_target, .path = "payload.value.callee" }} },
        .{
            .key = "pl_op/CondBr", .ignore = .{"data.operand", "payload.value.branch_hints"},
            .ops = .{"payload.value.condition"},
            .bodies = .{
                .{ .label = "then", .path = "payload.value.then_body" },
                .{ .label = "else", .path = "payload.value.else_body" },
            },
        },
        .{ .key = "pl_op/SwitchBr", .ignore = .{"data.operand"}, .ops = .{"payload.value.operand"}, .special = .switch_br },
        .{ .key = "pl_op/Try", .ignore = .{"data.operand"}, .ops = .{"payload.value.error_union"}, .bodies = .{.{ .label = "error", .path = "payload.value.else_body" }} },
        .{ .key = "pl_op/str", .ignore = .{"data.payload"}, .ops = .{"data.operand"}, .attrs = .{.{ .key = "name", .kind = .str, .path = "payload_str" }} },
        .{
            .key = "pl_op/AtomicRmw", .ignore = .{"payload.value.flags"},
            .ops = .{ "data.operand", "payload.value.operand" },
            .attrs = .{
                .{ .key = "op", .kind = .str, .path = "payload.value.op" },
                .{ .key = "order", .kind = .str, .path = "payload.value.ordering" },
            },
        },
        .{ .key = "pl_op/Bin", .ops = .{ "data.operand", "payload.value.lhs", "payload.value.rhs" } },
    },
}
