.{ .rules = .{
    .{
        .name = "export-call",
        .file = "src/Zcu/PerThread.zig",
        .anchor = .{ .text = "var air = try pt.analyzeFuncBodyInner(func_index, reason);" },
        .position = .after,
        .insert = "try Compilation.zv_air.exportFunc(pt, func_index, &air);",
    },
    .{
        .name = "import",
        .file = "src/Compilation.zig",
        .anchor = .{ .text = "const InternPool = @import(\"InternPool.zig\");" },
        .position = .after,
        .insert = "pub const zv_air = @import(\"zv_air/export.zig\");",
    },
    .{
        .name = "field",
        .file = "src/Compilation.zig",
        .anchor = .{ .text = "clang_preprocessor_mode: ClangPreprocessorMode," },
        .position = .after,
        .insert = "zv_air_options: zv_air.Options,",
    },
    .{
        .name = "create-option",
        .file = "src/Compilation.zig",
        .anchor = .{ .text = "clang_passthrough_mode: bool = false," },
        .position = .after,
        .insert = "zv_air_options: zv_air.Options = .{},",
    },
    .{
        .name = "create-init",
        .file = "src/Compilation.zig",
        .anchor = .{ .text = ".clang_preprocessor_mode = options.clang_preprocessor_mode," },
        .position = .after,
        .insert = ".zv_air_options = options.zv_air_options,",
    },
    .{
        .name = "cache-key",
        .file = "src/Compilation.zig",
        .anchor = .{ .text = "man.hash.add(zcu.error_limit);" },
        .position = .after,
        .insert = "comp.zv_air_options.hash(&man.hash);",
    },
    .{
        .name = "main-var",
        .file = "src/main.zig",
        .anchor = .{ .text = "var listen: Listen = .none;" },
        .position = .after,
        .insert = "var zv_air: Compilation.zv_air.Options = .fromEnviron(environ_map);",
    },
    .{
        .name = "main-flags",
        .file = "src/main.zig",
        .anchor = .{ .text_after = .{ .prev = "};", .line = "} else if (mem.eql(u8, arg, \"--debug-compile-errors\")) {" } },
        .position = .before,
        .insert =
        \\} else if (mem.eql(u8, arg, "--zv-air-out")) {
        \\    zv_air.out_dir = args_iter.nextOrFatal();
        \\} else if (mem.eql(u8, arg, "--zv-air-std")) {
        \\    zv_air.include_std = true;
        ,
    },
    .{
        .name = "main-pass",
        .file = "src/main.zig",
        .anchor = .{ .text = ".libc_installation = if (create_module.libc_installation) |*lci| lci else null," },
        .position = .after,
        .insert = ".zv_air_options = zv_air,",
    },
} }
