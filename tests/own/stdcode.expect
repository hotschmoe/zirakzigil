# Ordinary allocator-heavy code over std containers (tests/own/stdcode.zig): ok* must stay clean, bad* are mistakes.
# gapConditionalFree is a mistake the checker does not see: freeIfSome frees on one path only, so no caller may rely on it.
# fpOwnedAssertThenDeinit is correct and clean: toOwnedSliceAssert moves the buffer out and leaves the list empty.
# gapRemapIgnored is a mistake the checker does not see: the result of remap says whether the memory moved, and nothing looks.
stdcode.Gadget.first clean
stdcode.Gadget.push clean
stdcode.Interner.deinit clean
stdcode.Interner.intern clean
stdcode.Interner.name clean
stdcode.Slab.acquire clean
stdcode.Slab.deinit clean
stdcode.Slab.get clean
stdcode.Slab.release clean
stdcode.badAddOneAcrossInsert error
stdcode.badAdoptTwice error
stdcode.badAtomicAfterFree error
stdcode.badCmpxchgAfterFree error
stdcode.badDoubleDeinit error
stdcode.badGadgetFirstAcrossGrow error
stdcode.badGetOrPutPtrAcrossPut error
stdcode.badGrowWrapperUse error
stdcode.badInternerPointerAcrossIntern error
stdcode.badIntrusiveAfterDestroy error
stdcode.badKeysAcrossPut error
stdcode.badLoopCaptureAppend error
stdcode.badMapPtrAcrossLoopPut error
stdcode.badMutualFree error
stdcode.badMutualHeld error
stdcode.badNestedPtr error
stdcode.badRemapUse error
stdcode.badSlabPointerAcrossAcquire error
stdcode.badSliceAcrossAppend error
stdcode.badSliceAcrossHelperPush error
stdcode.badToOwnedKeepsPointer error
stdcode.badTreeUseAfterFree error
stdcode.badUseAfterDeinitMap error
stdcode.badValuePtrAcrossPut error
stdcode.classOf clean
stdcode.countA clean
stdcode.countB clean
stdcode.fpOwnedAssertThenDeinit clean
stdcode.freeA clean
stdcode.freeB clean
