registry.Plain.get clean
registry.Plain.remove clean
registry.Registry.add clean
registry.Registry.get clean
registry.Registry.remove clean
registry.badRegistryStale error
registry.gapPlainStale clean
registry.okRegistryOtherSlot clean
registry.okRegistryUse clean
