# Labeled switch loops, and idioms of the validations. badTokenizeStale keeps a pointer into a list across the growth in the
# loop, badFreeInSwitchLoop frees a block on every dispatch.
switchloop.badFreeInSwitchLoop error
switchloop.badTokenizeStale error
switchloop.okFreeThroughArena clean
switchloop.okIndirectKeeps counted
switchloop.okIndirectResult counted
switchloop.okTokenize counted
switchloop.Source.at clean
